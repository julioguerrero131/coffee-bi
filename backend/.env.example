# Environment settings
PROJECT_NAME="Coffee BI API"
API_V1_STR="/api/v1"

# Database settings
# Replace this with your actual MongoDB Atlas URI in your .env file
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI="<url-mongo>"
MONGO_DB="<db-name>"
MONGO_COLLECTION_SALES="<collection-name>"
